# Behind another reverse proxy that is itself behind Cloudflare (traefik mode's
# default; a Cloudflare Tunnel into behind-proxy mode). Trust private ranges —
# the proxy in front of Caddy — and Cloudflare's published ranges, and walk
# X-Forwarded-For from the right past both. CF-Connecting-IP is consulted only
# when every hop in X-Forwarded-For was trusted: a request that reaches Traefik
# directly, with forged headers, arrives with its own address appended by
# Traefik, and that address is what it is keyed on.
#
# AGENTBOX_REAL_IP_HEADER, when set, is read first, as in proxied-off.caddy;
# the proxy in front of Caddy must overwrite it on every request.
#
# The ranges come from https://www.cloudflare.com/ips-v4 and /ips-v6;
# scripts/refresh-cloudflare-ips.sh rewrites the line below from them.
trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
client_ip_headers {$AGENTBOX_REAL_IP_HEADER} X-Forwarded-For CF-Connecting-IP
trusted_proxies_strict
