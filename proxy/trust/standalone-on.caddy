# Standalone behind Cloudflare (a proxied DNS record): requests arrive from
# Cloudflare's edge. Trust exactly Cloudflare's published ranges, walk
# X-Forwarded-For from the right past them, and fall back to CF-Connecting-IP
# only when every hop in it was Cloudflare. A request that reaches this box
# directly, not through Cloudflare, is keyed on its own address whatever
# headers it forges.
#
# The ranges come from https://www.cloudflare.com/ips-v4 and /ips-v6;
# scripts/refresh-cloudflare-ips.sh rewrites the line below from them.
trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
client_ip_headers X-Forwarded-For CF-Connecting-IP
trusted_proxies_strict
