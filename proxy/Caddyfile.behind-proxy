# Behind-proxy (and traefik): no TLS and no ACME here — the host's existing
# reverse proxy terminates TLS and forwards to this listener, which hands every
# request to the gate. The gate authenticates at this hop, so the sandbox is
# never reachable unauthenticated, even from the host.
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	# The original Host passes through unchanged — so the proxy in front must
	# forward it too — and Caddy sets X-Forwarded-For, -Proto and -Host itself.
	# The gate believes those only on connections from this container; to key
	# rate limits on the real client behind another proxy, name the header that
	# proxy sets in AGENTBOX_CLIENT_IP_HEADER. WebSocket upgrades and streamed
	# responses pass through as they are.
	reverse_proxy gate:7900
}
