# Behind-proxy: no TLS and no ACME here — the host's existing reverse proxy
# terminates TLS and forwards to this listener. Authentication still happens at
# this hop, so the sandbox is never reachable unauthenticated even from the host.
{
	admin off
	auto_https off
}

# Shared routing, defined before use: Caddy resolves snippets in file order.
(routes) {
	# A full-screen shell, handy for running an agent as a TUI.
	handle /terminal* {
		reverse_proxy terminal:7681
	}

	# Live CPU, memory and process usage for the sandbox.
	handle /monitor* {
		reverse_proxy monitor:7682
	}

	# Everything else is the editor, served at the root so VS Code needs no
	# sub-path gymnastics.
	handle {
		reverse_proxy code:8080
	}
}

:8080 {
	encode zstd gzip

	basic_auth {
		{$AGENTBOX_USER} {$AGENTBOX_PASSWORD_HASH}
	}

	import routes
}
