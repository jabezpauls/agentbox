# Behind-proxy: no TLS and no ACME here — the host's existing reverse proxy
# terminates TLS and forwards to this listener. Authentication still happens at
# this hop, so the sandbox is never reachable unauthenticated even from the host.
{
	admin off
	auto_https off
}

# Shared routing, defined before use: Caddy resolves snippets in file order.
(routes) {
	# herdr's client, full-screen: the agent multiplexer, handy for running
	# agents as a TUI. Shares the editor's network namespace.
	handle /terminal* {
		reverse_proxy code:7681
	}

	# The Workbench: the browser client for herdr, served under its own base
	# path (the app is built with that prefix, so no rewriting is needed).
	handle /workbench* {
		reverse_proxy code:7800
	}

	# Live CPU, memory and process usage for the sandbox.
	handle /monitor* {
		reverse_proxy code:7682
	}

	# A plain bash shell, when you want that instead of the herdr client.
	handle /shell* {
		reverse_proxy code:7683
	}

	# Everything else is the editor, served at the root so VS Code needs no
	# sub-path gymnastics.
	handle {
		reverse_proxy code:8080
	}
}

:8080 {
	encode zstd gzip

	basic_auth {
		{$AGENTBOX_USER} {$AGENTBOX_PASSWORD_HASH}
	}

	# Separate hostnames arrive on the same listener here, because the fronting
	# proxy terminates TLS for all of them and forwards to this one port. They
	# are matched by Host rather than split into their own site blocks.

	# PORT.<preview-domain>: the port is taken from the hostname and the
	# request is rewritten onto the bridge's preview proxy. Only numeric
	# subdomains match, so nothing else on the preview domain is reachable.
	@preview {
		host *.{$AGENTBOX_PREVIEW_DOMAIN}
		header_regexp port Host ^([0-9]{1,5})\.
	}
	handle @preview {
		rewrite * /workbench/preview/{re.port.1}{uri}
		reverse_proxy code:7800
	}

	import routes
}
