# Per-port preview hostnames, imported by proxy/Caddyfile.standalone when
# AGENTBOX_PREVIEW_DOMAIN is set (docker-compose.previews.yml mounts this file
# into /etc/caddy/previews/). A wildcard DNS record must point *.<preview
# domain> at this host.
#
# Certificates are issued on demand and gated to numeric subdomains by the
# /ask endpoint in the main file, so no DNS-provider plugin is needed for the
# wildcard and no one can make this box mint certificates for arbitrary names.
*.{$AGENTBOX_PREVIEW_DOMAIN} {
	encode zstd gzip

	tls {
		on_demand
	}

	basic_auth {
		{$AGENTBOX_USER} {$AGENTBOX_PASSWORD_HASH}
	}

	# The port comes from the hostname; everything else is passed through to
	# the bridge's preview proxy, which only ever talks to loopback ports.
	@port header_regexp port Host ^([0-9]{1,5})\.
	handle @port {
		rewrite * /workbench/preview/{re.port.1}{uri}
		reverse_proxy code:7800
	}

	respond 404
}
