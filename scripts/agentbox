#!/usr/bin/env bash
# Thin wrapper so day-to-day operations do not require remembering which
# compose overlay is in use — it is read from .env.
set -euo pipefail
# Resolved before the cd below, so sibling scripts are found from any cwd.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."
[ -f .env ] || { echo "no .env here; run install.sh first" >&2; exit 1; }
MODE="$(grep '^AGENTBOX_MODE=' .env | cut -d= -f2-)"
DC=(docker compose -f docker-compose.yml -f "docker-compose.${MODE}.yml")
# The per-port preview hostnames are an add-on to either mode; compose them in
# whenever a preview domain is configured, so every command sees the same stack.
PREVIEW_DOMAIN="$(grep '^AGENTBOX_PREVIEW_DOMAIN=' .env | cut -d= -f2- || true)"
[ -n "$PREVIEW_DOMAIN" ] && DC+=(-f docker-compose.previews.yml)

# Replace (or add) a single KEY=value line in .env, atomically and 0600. A
# newline in the value would smuggle in a second key, so it is refused.
set_env() {
    local key="$1" val="$2" tmp
    case "$val" in
        *$'\n'*|*$'\r'*) echo "value for $key may not contain a newline" >&2; exit 1 ;;
    esac
    tmp="$(mktemp .env.XXXXXX)"
    grep -v "^${key}=" .env > "$tmp" || true
    printf '%s=%s\n' "$key" "$val" >> "$tmp"
    install -m 600 "$tmp" .env
    rm -f "$tmp"
}

case "${1:-help}" in
    start)   shift; "${DC[@]}" up -d "$@" ;;
    stop)    shift; "${DC[@]}" stop "$@" ;;
    restart) shift; "${DC[@]}" restart "$@" ;;
    status)  "${DC[@]}" ps ;;
    logs)    shift; "${DC[@]}" logs -f --tail=100 "$@" ;;
    shell)     "${DC[@]}" exec code bash -l ;;
    workbench) "${DC[@]}" logs -f --tail=100 workbench ;;
    update)
        # Adopt any of the install flags on an existing box: update .env, then
        # rebuild and restart with the resolved overlays. --agents and --preview
        # take effect on the rebuild; --mode swaps the overlay in place.
        shift
        ISOLATE="false"
        # Validate every flag before writing any, so a bad value late in the
        # list cannot leave the earlier ones half-applied.
        PENDING=()
        while [ $# -gt 0 ]; do
            val="${2:-}"
            case "$val" in
                *$'\n'*|*$'\r'*) echo "option values may not contain a newline" >&2; exit 1 ;;
            esac
            case "$1" in
                --agents)
                    case "$val" in
                        *[!a-z0-9,_-]*) echo "--agents takes a comma-separated list, e.g. claude,codex" >&2; exit 1 ;;
                    esac
                    PENDING+=("AGENTBOX_AGENTS=$val"); shift 2 ;;
                --preview)
                    case "$val" in
                        off|path) ;;
                        *) echo "--preview must be off or path" >&2; exit 1 ;;
                    esac
                    PENDING+=("AGENTBOX_PREVIEW_MODE=$val"); shift 2 ;;
                --mode)
                    case "$val" in
                        standalone|behind-proxy|traefik) ;;
                        *) echo "--mode must be standalone, behind-proxy or traefik" >&2; exit 1 ;;
                    esac
                    PENDING+=("AGENTBOX_MODE=$val"); shift 2 ;;
                --preview-domain) PENDING+=("AGENTBOX_PREVIEW_DOMAIN=$val"); shift 2 ;;
                --edge-network)   PENDING+=("AGENTBOX_EDGE_NETWORK=$val"); shift 2 ;;
                --cert-resolver)  PENDING+=("AGENTBOX_CERT_RESOLVER=$val"); shift 2 ;;
                --cpus)           PENDING+=("AGENTBOX_CPUS=$val"); shift 2 ;;
                --memory)         PENDING+=("AGENTBOX_MEMORY=$val"); shift 2 ;;
                --proxy-cpus)     PENDING+=("AGENTBOX_PROXY_CPUS=$val"); shift 2 ;;
                --proxy-memory)   PENDING+=("AGENTBOX_PROXY_MEMORY=$val"); shift 2 ;;
                --isolate-host)   ISOLATE="true"; shift ;;
                *) echo "unknown update option: $1" >&2; exit 1 ;;
            esac
        done
        for kv in "${PENDING[@]}"; do set_env "${kv%%=*}" "${kv#*=}"; done
        git pull --ff-only
        # Recompute the overlays in case --mode or --preview-domain just changed.
        MODE="$(grep '^AGENTBOX_MODE=' .env | cut -d= -f2-)"
        OVERLAYS=(-f docker-compose.yml -f "docker-compose.${MODE}.yml")
        PREVIEW_DOMAIN="$(grep '^AGENTBOX_PREVIEW_DOMAIN=' .env | cut -d= -f2- || true)"
        [ -n "$PREVIEW_DOMAIN" ] && OVERLAYS+=(-f docker-compose.previews.yml)
        docker compose "${OVERLAYS[@]}" build --pull
        docker compose "${OVERLAYS[@]}" up -d
        if [ "$ISOLATE" = "true" ]; then
            # shellcheck source=scripts/isolate-host.sh
            . "$SCRIPT_DIR/isolate-host.sh"
            agentbox_isolate_host "${OVERLAYS[@]}"
        fi
        ;;
    password)
        [ $# -ge 2 ] && NEW="$2" || NEW="$(tr -dc 'a-z0-9' </dev/urandom | head -c 20)"
        HASH="$(docker run --rm caddy:2-alpine caddy hash-password --plaintext "$NEW")"
        # Escape '$' so Compose does not interpolate the bcrypt hash away.
        HASH="$(printf '%s' "$HASH" | sed 's/[$]/$$/g')"
        tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
        grep -v '^AGENTBOX_PASSWORD_HASH=' .env > "$tmp"
        printf 'AGENTBOX_PASSWORD_HASH=%s\n' "$HASH" >> "$tmp"
        install -m 600 "$tmp" .env
        "${DC[@]}" up -d proxy
        echo "new password: $NEW"
        ;;
    backup)
        out="${2:-agentbox-backup-$(date +%Y%m%d-%H%M%S).tar.gz}"
        docker run --rm -v agentbox_workspace:/w:ro -v agentbox_home:/h:ro \
            -v "$PWD:/out" alpine \
            tar czf "/out/$(basename "$out")" -C / w h
        echo "wrote $out"
        ;;
    restore)
        [ $# -ge 2 ] || { echo "usage: agentbox restore <file.tar.gz>" >&2; exit 1; }
        "${DC[@]}" down
        docker run --rm -v agentbox_workspace:/w -v agentbox_home:/h \
            -v "$PWD:/in" alpine \
            sh -c "rm -rf /w/* /h/* && tar xzf '/in/$(basename "$2")' -C /"
        "${DC[@]}" up -d
        echo "restored from $2"
        ;;
    destroy)
        read -rp "Delete containers AND the workspace volume? Type 'delete': " c
        [ "$c" = "delete" ] || { echo "aborted"; exit 1; }
        "${DC[@]}" down -v
        ;;
    *)
        cat <<'HELP'
agentbox <command>

  start | stop | restart | status | logs [service]
  shell                 a shell inside the sandbox
  workbench             follow the Workbench bridge's logs
  update [flags]        pull, rebuild, restart; accepts the install flags
                        (--agents, --preview, --preview-domain, --mode,
                        --cert-resolver, --edge-network, --cpus, --memory,
                        --proxy-cpus, --proxy-memory, --isolate-host)
  password [new]        rotate the login password
  backup [file]         archive the workspace and home volumes
  restore <file>        replace volumes from an archive
  destroy               remove everything, including your files
HELP
        ;;
esac
