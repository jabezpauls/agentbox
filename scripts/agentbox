#!/usr/bin/env bash
# Thin wrapper so day-to-day operations do not require remembering which
# compose overlay is in use — it is read from .env.
set -euo pipefail
# Resolved before the cd below, so sibling scripts are found from any cwd.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."
[ -f .env ] || { echo "no .env here; run install.sh first" >&2; exit 1; }
# An install made as root (sudo bash install.sh) keeps a root-only .env.
[ -r .env ] || { echo "cannot read $PWD/.env: this install belongs to $(stat -c %U .env 2>/dev/null || echo another user); run: sudo $0 $*" >&2; exit 1; }
# The mode's overlay; traefik with TLS passed through to Caddy has its own.
overlay() {
    local mode tls
    mode="$(grep -m1 '^AGENTBOX_MODE=' .env | cut -d= -f2-)"
    tls="$(grep -m1 '^AGENTBOX_TLS=' .env | cut -d= -f2- || true)"
    if [ "$mode" = traefik ] && [ "$tls" = passthrough ]; then echo traefik-passthrough; else echo "$mode"; fi
}
DC=(docker compose -f docker-compose.yml -f "docker-compose.$(overlay).yml")

# Run the gate's admin command. The running gate owns its store, so the command
# goes to it (it waits for a gate that is still starting); with the gate
# stopped, a throwaway container edits the store directly instead. A gate that
# is restarting is neither, and a second writer then could lose the change, so
# that is refused. (The throwaway container also checks the gate's lease on the
# volume, for whoever runs it by hand.)
gate_cmd() {
    local state
    state="$("${DC[@]}" ps -a --format '{{.State}}' gate 2>/dev/null | head -n1)"
    case "$state" in
        running) "${DC[@]}" exec -T gate agentbox-gate "$@" ;;
        restarting|starting|created)
            echo "the gate is $state; wait for it to come up (./scripts/agentbox logs gate) and try again" >&2
            return 1 ;;
        *) "${DC[@]}" run --rm --no-deps -T gate agentbox-gate --offline "$@" ;;
    esac
}

# Replace (or add) a single KEY=value line in .env, atomically and 0600. A
# newline in the value would smuggle in a second key, so it is refused.
set_env() {
    local key="$1" val="$2" tmp
    case "$val" in
        *$'\n'*|*$'\r'*) echo "value for $key may not contain a newline" >&2; exit 1 ;;
    esac
    tmp="$(mktemp .env.XXXXXX)"
    grep -v "^${key}=" .env > "$tmp" || true
    printf '%s=%s\n' "$key" "$val" >> "$tmp"
    install -m 600 "$tmp" .env
    rm -f "$tmp"
}

# Drop a KEY=value line from .env, atomically and 0600.
unset_env() {
    local tmp
    tmp="$(mktemp .env.XXXXXX)"
    grep -v "^$1=" .env > "$tmp" || true
    install -m 600 "$tmp" .env
    rm -f "$tmp"
}

# real_ip_header_problem <value>: say what is wrong with a client-IP header
# name, and succeed, if anything is (see install.sh --real-ip-header). Caddy
# reads it alongside X-Forwarded-For and CF-Connecting-IP; naming one of those
# again stops it starting, and it is spliced into Caddy's config.
real_ip_header_problem() {
    case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
        "") return 1 ;;
        cf-connecting-ip)
            echo "AGENTBOX_REAL_IP_HEADER=CF-Connecting-IP: Cloudflare's header is read with --cloudflare on (and only from Cloudflare's addresses); use that, and leave the header empty" >&2 ;;
        x-forwarded-for)
            echo "AGENTBOX_REAL_IP_HEADER=X-Forwarded-For: that header is always read; leave it empty (behind Cloudflare, use --cloudflare on)" >&2 ;;
        x-agentbox-client-ip)
            echo "AGENTBOX_REAL_IP_HEADER=X-Agentbox-Client-IP: that header is agentbox's own, written by its proxy for the gate" >&2 ;;
        *[!a-z0-9-]*)
            echo "AGENTBOX_REAL_IP_HEADER must be a header name (letters, digits, dashes), e.g. X-Real-IP" >&2 ;;
        *) return 1 ;;
    esac
    return 0
}

env_get() { grep -m1 "^$1=" .env | cut -d= -f2- || true; }

# Twenty random lowercase letters and digits (see install.sh: a fixed read,
# so nothing in the pipeline is cut off and pipefail stays quiet).
random_password() {
    local p
    p="$(head -c 4096 /dev/urandom | LC_ALL=C tr -dc 'a-z0-9' | cut -c1-20)"
    [ "${#p}" -eq 20 ] || { echo "could not generate a password" >&2; exit 1; }
    printf '%s' "$p"
}

# The names a box that builds its own images gives them: the names every
# install used before releases, so a box updated from then keeps its images.
LOCAL_WORKSPACE_IMAGE="agentbox/workspace:latest"
LOCAL_GATE_IMAGE="agentbox/gate:latest"
TAG_RE='^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$'

# Whether this box builds its images (on) or pulls the release's (off).
# AGENTBOX_BUILD decides when set. Otherwise a checkout, or a directory that is
# not a release, builds (there is no published image for it), and so does a
# release with coding agents other than the pair its image carries.
wants_build() {
    case "$(env_get AGENTBOX_BUILD)" in
        on) return 0 ;;
        off) return 1 ;;
    esac
    [ -e .git ] && return 0
    [ -n "$(env_get AGENTBOX_TAG)" ] || return 0
    # Unset means the default pair; set empty means none.
    local agents
    if grep -q '^AGENTBOX_AGENTS=' .env; then agents="$(env_get AGENTBOX_AGENTS)"; else agents="claude,codex"; fi
    [ "$(printf '%s' "$agents" | tr -d ' \t\r' | tr ',' '\n' | grep -v '^$' | sort -u | paste -sd, -)" != "claude,codex" ]
}

# release_url <tag|""> <file>: where a release's file is; "" is the latest.
# The same layout as GitHub's releases, which is the default.
release_url() {
    local base="${AGENTBOX_RELEASE_URL:-$(env_get AGENTBOX_RELEASE_URL)}"
    base="${base:-https://github.com/jabezpauls/agentbox/releases}"
    base="${base%/}"
    if [ -z "$1" ]; then printf '%s/latest/download/%s' "$base" "$2"; else printf '%s/download/%s/%s' "$base" "$1" "$2"; fi
}

# fetch_release <tag|"">: download a release and its SHA256SUMS, refuse it
# unless they match (before anything is unpacked), and unpack it over this
# directory, keeping .env and anything else the release does not carry. Sets
# RELEASE_TAG. A mirror without checksums needs AGENTBOX_INSECURE_SKIP_VERIFY=1.
# (install.sh has the same function, for a first install.)
fetch_release() {
    local want="$1" tmp sums
    command -v sha256sum >/dev/null 2>&1 || { echo "sha256sum is required to check the download" >&2; return 1; }
    tmp="$(mktemp -d)"
    echo "==> Downloading agentbox ${want:-(latest release)}"
    if ! curl -fsSL -o "$tmp/agentbox.tar.gz" "$(release_url "$want" agentbox.tar.gz)"; then
        rm -rf "$tmp"; echo "could not download $(release_url "$want" agentbox.tar.gz)" >&2; return 1
    fi
    # The checksums from the same place as the bundle, checked before tar
    # reads a byte of it.
    if curl -fsSL -o "$tmp/SHA256SUMS" "$(release_url "$want" SHA256SUMS)"; then
        sums="$(grep -E ' \*?agentbox\.tar\.gz$' "$tmp/SHA256SUMS" | head -n1 | cut -d' ' -f1)"
        if [ -z "$sums" ] || [ "$sums" != "$(sha256sum "$tmp/agentbox.tar.gz" | cut -d' ' -f1)" ]; then
            rm -rf "$tmp"; echo "agentbox.tar.gz does not match the release's SHA256SUMS; not installing it" >&2; return 1
        fi
    elif [ "${AGENTBOX_INSECURE_SKIP_VERIFY:-}" = 1 ]; then
        echo "warning: no SHA256SUMS at $(release_url "$want" SHA256SUMS); updating unchecked (AGENTBOX_INSECURE_SKIP_VERIFY=1)" >&2
    else
        rm -rf "$tmp"
        echo "could not download $(release_url "$want" SHA256SUMS), so the release cannot be checked; not installing it. (For a mirror without checksums: AGENTBOX_INSECURE_SKIP_VERIFY=1.)" >&2
        return 1
    fi
    mkdir "$tmp/x"
    if ! tar -xzf "$tmp/agentbox.tar.gz" -C "$tmp/x" --strip-components=1; then
        rm -rf "$tmp"; echo "the downloaded release is not a valid archive" >&2; return 1
    fi
    RELEASE_TAG="$(head -n1 "$tmp/x/VERSION" 2>/dev/null || true)"
    if ! printf '%s' "$RELEASE_TAG" | grep -Eq "$TAG_RE"; then
        rm -rf "$tmp"; echo "the downloaded release does not say which version it is" >&2; return 1
    fi
    if [ -n "$want" ] && [ "$want" != "$RELEASE_TAG" ]; then
        rm -rf "$tmp"; echo "asked for $want, but the download is $RELEASE_TAG" >&2; return 1
    fi
    # A fresh inode for every file, this script included, so the copy that is
    # running keeps reading its own lines.
    cp -R --remove-destination "$tmp/x/." ./ 2>/dev/null || cp -R "$tmp/x/." ./
    rm -rf "$tmp"
}

# Pull the release's images, or build them here, then start the stack and
# remove any service this version no longer has. install.sh ends with this, and
# so does `update`, run from the new version's copy of this script.
apply() {
    local ws
    if wants_build; then
        [ -f images/workspace/Dockerfile ] && [ -d web ] \
            || { echo "this directory has no sources to build the images from (images/, web/)" >&2; exit 1; }
        # A local build gets a local name, never the registry's: a later pull
        # must not replace it, nor it pass for the published image. Names set by
        # hand are kept.
        [ -n "$(env_get AGENTBOX_WORKSPACE_IMAGE)" ] || set_env AGENTBOX_WORKSPACE_IMAGE "$LOCAL_WORKSPACE_IMAGE"
        [ -n "$(env_get AGENTBOX_GATE_IMAGE)" ] || set_env AGENTBOX_GATE_IMAGE "$LOCAL_GATE_IMAGE"
        echo "==> Building the sandbox and gate images here (the first build takes a few minutes)"
        # --pull refreshes the base images, so a rebuild picks up their fixes.
        "${DC[@]}" build --pull
    else
        # Back from a local build: the names it set go, so the release's
        # images are used again. Names set by hand stay.
        [ "$(env_get AGENTBOX_WORKSPACE_IMAGE)" = "$LOCAL_WORKSPACE_IMAGE" ] && unset_env AGENTBOX_WORKSPACE_IMAGE
        [ "$(env_get AGENTBOX_GATE_IMAGE)" = "$LOCAL_GATE_IMAGE" ] && unset_env AGENTBOX_GATE_IMAGE
        echo "==> Pulling the agentbox $(env_get AGENTBOX_TAG) images"
        "${DC[@]}" pull --quiet
        # Compose lets a pull of a buildable service fail quietly; a box must
        # not then start (or build) something other than the release.
        for ws in $("${DC[@]}" config --images | sort -u); do
            if ! docker image inspect "$ws" >/dev/null 2>&1; then
                echo "could not pull $ws. Is the release published, and can this server reach the registry? To build the images here instead: ./scripts/agentbox update --build" >&2
                exit 1
            fi
        done
    fi
    "${DC[@]}" up -d --no-build --remove-orphans
}

case "${1:-help}" in
    start)   shift; "${DC[@]}" up -d "$@" ;;
    stop)    shift; "${DC[@]}" stop "$@" ;;
    restart)
        shift
        # The terminals and the Workbench live in the editor's network
        # namespace (network_mode: service:code). `compose restart` restarts
        # each on its own, so they come back joined to the namespace of a
        # `code` that no longer exists and exit ("cannot join network
        # namespace"). Restarting all of it, or `code`, stops the stack and
        # starts it again in order; any other service restarts alone.
        whole=1
        for s in "$@"; do [ "$s" = code ] && whole=1 && break; whole=0; done
        if [ "$whole" = 1 ]; then
            "${DC[@]}" stop
            "${DC[@]}" up -d
        else
            "${DC[@]}" restart "$@"
        fi
        ;;
    status)  "${DC[@]}" ps ;;
    logs)    shift; "${DC[@]}" logs -f --tail=100 "$@" ;;
    shell)     "${DC[@]}" exec code bash -l ;;
    workbench) "${DC[@]}" logs -f --tail=100 workbench ;;
    update)
        # Adopt any of the install flags on an existing box: update .env, then
        # rebuild and restart with the resolved overlays. --agents and --sharing
        # take effect on the rebuild; --mode swaps the overlay in place.
        shift
        ISOLATE="false"
        WANT=""
        WANT_GIVEN="false"
        # Validate every flag before writing any, so a bad value late in the
        # list cannot leave the earlier ones half-applied.
        PENDING=()
        while [ $# -gt 0 ]; do
            val="${2:-}"
            case "$val" in
                *$'\n'*|*$'\r'*) echo "option values may not contain a newline" >&2; exit 1 ;;
            esac
            case "$1" in
                --agents)
                    case "$val" in
                        *[!a-z0-9,_-]*) echo "--agents takes a comma-separated list, e.g. claude,codex" >&2; exit 1 ;;
                    esac
                    PENDING+=("AGENTBOX_AGENTS=$val"); shift 2 ;;
                --sharing)
                    case "$val" in
                        on|off) ;;
                        *) echo "--sharing must be on or off" >&2; exit 1 ;;
                    esac
                    PENDING+=("AGENTBOX_SHARING=$val"); shift 2 ;;
                --preview)
                    # The older name of --sharing: path allowed sharing, off did not.
                    case "$val" in
                        path) PENDING+=("AGENTBOX_SHARING=on") ;;
                        off) PENDING+=("AGENTBOX_SHARING=off") ;;
                        *) echo "--preview must be off or path (or use --sharing on|off)" >&2; exit 1 ;;
                    esac
                    shift 2 ;;
                --cloudflare)
                    case "$val" in
                        on|off) ;;
                        *) echo "--cloudflare must be on or off" >&2; exit 1 ;;
                    esac
                    PENDING+=("AGENTBOX_CLOUDFLARE=$val"); shift 2 ;;
                --real-ip-header)
                    real_ip_header_problem "$val" && exit 1
                    PENDING+=("AGENTBOX_REAL_IP_HEADER=$val"); shift 2 ;;
                --mode)
                    case "$val" in
                        standalone|behind-proxy|traefik) ;;
                        *) echo "--mode must be standalone, behind-proxy or traefik" >&2; exit 1 ;;
                    esac
                    PENDING+=("AGENTBOX_MODE=$val"); shift 2 ;;
                --preview-domain)
                    # Per-port preview hostnames were removed: the gate's
                    # sign-in cookie is host-only and never reaches them.
                    echo "warning: --preview-domain no longer does anything; ignoring it" >&2
                    shift 2 ;;
                --edge-network)   PENDING+=("AGENTBOX_EDGE_NETWORK=$val"); shift 2 ;;
                --cert-resolver)  PENDING+=("AGENTBOX_CERT_RESOLVER=$val"); shift 2 ;;
                --tls)
                    case "$val" in
                        edge|passthrough) ;;
                        *) echo "--tls must be edge or passthrough" >&2; exit 1 ;;
                    esac
                    PENDING+=("AGENTBOX_TLS=$val"); shift 2 ;;
                --cpus)           PENDING+=("AGENTBOX_CPUS=$val"); shift 2 ;;
                --memory)         PENDING+=("AGENTBOX_MEMORY=$val"); shift 2 ;;
                --proxy-cpus)     PENDING+=("AGENTBOX_PROXY_CPUS=$val"); shift 2 ;;
                --proxy-memory)   PENDING+=("AGENTBOX_PROXY_MEMORY=$val"); shift 2 ;;
                --isolate-host)   ISOLATE="true"; shift ;;
                --build)          PENDING+=("AGENTBOX_BUILD=on"); shift ;;
                --no-build)       PENDING+=("AGENTBOX_BUILD=off"); shift ;;
                --version)
                    WANT_GIVEN="true"
                    case "$val" in
                        latest) WANT="" ;;
                        [0-9]*) WANT="v$val" ;;
                        *) WANT="$val" ;;
                    esac
                    if [ -n "$WANT" ] && ! printf '%s' "$WANT" | grep -Eq "$TAG_RE"; then
                        echo "--version takes a release tag such as v1.2.0, or latest" >&2; exit 1
                    fi
                    shift 2 ;;
                *) echo "unknown update option: $1" >&2; exit 1 ;;
            esac
        done
        if [ "$WANT_GIVEN" = "true" ] && [ -e .git ]; then
            echo "this install is a git checkout: check out the tag you want, then run update without --version" >&2; exit 1
        fi
        for kv in "${PENDING[@]}"; do set_env "${kv%%=*}" "${kv#*=}"; done
        # An .env from before AGENTBOX_CLOUDFLARE said it with
        # AGENTBOX_CLIENT_IP_HEADER; carry that over, as install.sh does, rather
        # than let the mode's default decide.
        if ! grep -q '^AGENTBOX_CLOUDFLARE=' .env; then
            if grep -q '^AGENTBOX_CLIENT_IP_HEADER=' .env; then
                case "$(grep -m1 '^AGENTBOX_CLIENT_IP_HEADER=' .env | cut -d= -f2- | tr '[:upper:]' '[:lower:]')" in
                    cf-connecting-ip) set_env AGENTBOX_CLOUDFLARE on ;;
                    *) set_env AGENTBOX_CLOUDFLARE off ;;
                esac
            elif [ "$(grep -m1 '^AGENTBOX_MODE=' .env | cut -d= -f2-)" = traefik ]; then
                set_env AGENTBOX_CLOUDFLARE on
            else
                set_env AGENTBOX_CLOUDFLARE off
            fi
        fi
        # That older key also named the header Traefik's rate limit keyed on.
        # Caddy reads AGENTBOX_REAL_IP_HEADER instead (a name it already reads,
        # listed twice, would stop it starting): only another header moves
        # over, and the old key goes.
        if grep -q '^AGENTBOX_CLIENT_IP_HEADER=' .env; then
            old="$(grep -m1 '^AGENTBOX_CLIENT_IP_HEADER=' .env | cut -d= -f2-)"
            if ! grep -q '^AGENTBOX_REAL_IP_HEADER=' .env; then
                case "$(printf '%s' "$old" | tr '[:upper:]' '[:lower:]')" in
                    ""|cf-connecting-ip|x-forwarded-for) ;;
                    *) set_env AGENTBOX_REAL_IP_HEADER "$old" ;;
                esac
            fi
            unset_env AGENTBOX_CLIENT_IP_HEADER
        fi
        # An .env from before --sharing said it with AGENTBOX_PREVIEW_MODE.
        if grep -q '^AGENTBOX_PREVIEW_MODE=' .env; then
            if ! grep -q '^AGENTBOX_SHARING=' .env; then
                if [ "$(grep -m1 '^AGENTBOX_PREVIEW_MODE=' .env | cut -d= -f2-)" = off ]; then
                    set_env AGENTBOX_SHARING off
                else
                    set_env AGENTBOX_SHARING on
                fi
            fi
            unset_env AGENTBOX_PREVIEW_MODE
        fi
        # Passthrough serves a DNS-only record with nothing in front of Caddy
        # reading the request (the overlay ignores both settings; .env should
        # say so too).
        if [ "$(grep -m1 '^AGENTBOX_TLS=' .env | cut -d= -f2- || true)" = passthrough ]; then
            if [ "$(grep -m1 '^AGENTBOX_MODE=' .env | cut -d= -f2-)" != traefik ]; then
                echo "--tls passthrough is for traefik mode" >&2; exit 1
            fi
            if grep -q '^AGENTBOX_CLOUDFLARE=on$' .env; then
                echo "note: --tls passthrough serves a DNS-only record; setting AGENTBOX_CLOUDFLARE=off" >&2
                set_env AGENTBOX_CLOUDFLARE off
            fi
            if grep -q '^AGENTBOX_REAL_IP_HEADER=.' .env; then
                echo "note: --tls passthrough: no proxy in front of Caddy sets a header; clearing AGENTBOX_REAL_IP_HEADER" >&2
                set_env AGENTBOX_REAL_IP_HEADER ""
            fi
        fi
        # A header set by hand is checked before anything restarts.
        real_ip_header_problem "$(grep -m1 '^AGENTBOX_REAL_IP_HEADER=' .env | cut -d= -f2- || true)" && exit 1
        if [ -e .git ]; then
            # A checkout (every install before releases): pull, and build.
            git pull --ff-only
            # The version the rebuilt images will report (see install.sh).
            set_env AGENTBOX_VERSION "$(git describe --tags --always --dirty 2>/dev/null || echo dev)"
        elif [ -n "$(env_get AGENTBOX_TAG)" ] || [ -f VERSION ] || [ "$WANT_GIVEN" = "true" ]; then
            # A release: the latest, or the one --version names. Its files
            # replace these; .env and the volumes stay as they are.
            current="$(env_get AGENTBOX_TAG)"
            fetch_release "$WANT" || exit 1
            if [ "$RELEASE_TAG" = "$current" ]; then
                echo "==> Already on agentbox $current"
            else
                echo "==> agentbox ${current:-(no release)} -> $RELEASE_TAG"
            fi
            set_env AGENTBOX_TAG "$RELEASE_TAG"
            set_env AGENTBOX_VERSION "$RELEASE_TAG"
        else
            echo "this directory is neither a release nor a checkout, so there is nothing to update it from. To move it onto releases (its .env and volumes are kept): ./scripts/agentbox update --version latest" >&2
            exit 1
        fi
        # The new version's copy of this script pulls or builds its images and
        # starts it. On a box updating from before the gate existed, the
        # gate's store is seeded from the password hash already in .env, so
        # the same password signs in on the new page. A service an update
        # removes (lavish, previews) stops: apply passes --remove-orphans.
        if [ "$ISOLATE" = "true" ]; then
            exec "$SCRIPT_DIR/agentbox" apply --isolate-host
        fi
        exec "$SCRIPT_DIR/agentbox" apply
        ;;
    apply)
        # Pull (or build) this version's images and (re)start: what install.sh
        # and update end with, and what to run after editing .env by hand.
        apply
        if [ "${2:-}" = "--isolate-host" ]; then
            # shellcheck source=scripts/isolate-host.sh
            . "$SCRIPT_DIR/isolate-host.sh"
            agentbox_isolate_host -f docker-compose.yml -f "docker-compose.$(overlay).yml"
        fi
        ;;
    passwd|password)
        # The gate's store holds the password; .env's hash only seeds a fresh
        # store, so it is left as it is.
        GENERATED=""
        if [ $# -ge 2 ]; then
            NEW="$2"
        elif [ -t 0 ]; then
            read -rsp "New password (blank to generate one): " NEW; echo
            if [ -n "$NEW" ]; then
                read -rsp "Again: " AGAIN; echo
                [ "$NEW" = "$AGAIN" ] || { echo "the passwords did not match" >&2; exit 1; }
            fi
        else
            NEW=""
        fi
        if [ -z "$NEW" ]; then
            NEW="$(random_password)"
            GENERATED="true"
        fi
        case "$NEW" in
            *$'\n'*|*$'\r'*) echo "a password may not contain a newline" >&2; exit 1 ;;
        esac
        # On stdin, never in argv, where any process listing would show it.
        OUT="$(printf '%s\n' "$NEW" | gate_cmd set-password)"
        # Keep .env's seed in step with the store, so restoring the stack's
        # files (or losing the gate's volume) cannot bring the old password back.
        HASH="$(printf '%s' "$OUT" | sed -n 's/.*"hash": *"\([^"]*\)".*/\1/p')"
        if [ -n "$HASH" ]; then
            set_env AGENTBOX_PASSWORD_HASH "$(printf '%s' "$HASH" | sed 's/[$]/$$/g')"
        else
            echo "warning: the gate did not return the new hash; .env still holds the old seed" >&2
        fi
        echo "password changed; every session was signed out"
        [ -n "$GENERATED" ] && echo "new password: $NEW"
        ;;
    totp)
        case "${2:-}" in
            reset)
                gate_cmd totp-reset >/dev/null
                echo "two-factor is off and every session was signed out; turn it back on from Settings after signing in"
                ;;
            *) echo "usage: agentbox totp reset" >&2; exit 1 ;;
        esac
        ;;
    gate)
        # The gate's other admin commands: status, unlock, revoke-all.
        shift
        [ $# -ge 1 ] || { echo "usage: agentbox gate <status|unlock|revoke-all>" >&2; exit 1; }
        gate_cmd "$@"
        ;;
    backup)
        # The workspace, home, and the gate's store (password hash, sessions,
        # two-factor, device tokens) — so a restore brings back the same
        # sign-in, not whatever .env's seed happens to say. Keep the archive as
        # private as .env.
        out="${2:-agentbox-backup-$(date +%Y%m%d-%H%M%S).tar.gz}"
        # Written by root in the container, then handed to whoever ran this, so
        # the archive can be copied off without sudo; still 0600. Under
        # rootless Docker the container's root already is that user, and a
        # chown to its uid would hand the file to a subordinate one instead.
        owner="$(id -u):$(id -g)"
        if docker info --format '{{.SecurityOptions}}' 2>/dev/null | grep -q rootless; then owner=""; fi
        docker run --rm -v agentbox_workspace:/w:ro -v agentbox_home:/h:ro -v agentbox_gate:/g:ro \
            -v "$PWD:/out" alpine \
            sh -ec 'umask 077; tar czf "/out/$1" --numeric-owner -C / w h g
                    [ -z "$2" ] || chown "$2" "/out/$1"; chmod 600 "/out/$1"' \
            sh "$(basename "$out")" "$owner"
        echo "wrote $PWD/$(basename "$out")"
        ;;
    restore)
        [ $# -ge 2 ] || { echo "usage: agentbox restore <file.tar.gz>" >&2; exit 1; }
        "${DC[@]}" down
        # An archive from before the gate existed has no g/: the gate's store is
        # then left alone rather than emptied.
        docker run --rm -v agentbox_workspace:/w -v agentbox_home:/h -v agentbox_gate:/g \
            -v "$PWD:/in" alpine \
            sh -ec 'a="/in/$1"; tar tzf "$a" >/dev/null; rm -rf /w/* /h/*
                    if tar tzf "$a" | grep -q "^g/"; then rm -rf /g/* /g/.[!.]*; fi
                    tar xzf "$a" --numeric-owner -C /' \
            sh "$(basename "$2")"
        "${DC[@]}" up -d
        echo "restored from $2"
        ;;
    destroy)
        read -rp "Delete containers AND the workspace volume? Type 'delete': " c
        [ "$c" = "delete" ] || { echo "aborted"; exit 1; }
        "${DC[@]}" down -v
        ;;
    *)
        cat <<'HELP'
agentbox <command>

  start | stop | restart | status | logs [service]
  shell                 a shell inside the sandbox
  workbench             follow the Workbench bridge's logs
  update [flags]        move to the latest release (or --version vX.Y.Z): fetch its
                        files, pull its images, restart; .env and your data stay.
                        Accepts the install flags (--agents, --sharing, --cloudflare,
                        --real-ip-header, --mode, --cert-resolver, --tls, --edge-network,
                        --cpus, --memory, --proxy-cpus, --proxy-memory, --isolate-host,
                        --build, --no-build). A git checkout pulls and rebuilds instead.
  apply                 pull (or build) this version's images and restart, e.g.
                        after editing .env by hand
  passwd [new]          set the sign-in password (prompted, or generated);
                        signs every session out
  totp reset            turn two-factor off, for a lost phone
  gate status|unlock|revoke-all
                        what the gate has; clear sign-in lockouts; end every
                        session and revoke every device token
  backup [file]         archive the workspace, home and gate volumes
  restore <file>        replace volumes from an archive
  destroy               remove everything, including your files
HELP
        ;;
esac
