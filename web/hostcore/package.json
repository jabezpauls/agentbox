{
  "name": "@workbench/hostcore", "private": true, "type": "module", "version": "0.1.0",
  "engines": { "node": ">=20" },
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./dist/hostcore/src/index.js" },
    "./link": { "types": "./src/link/index.ts", "default": "./dist/hostcore/src/link/index.js" },
    "./herdr": { "types": "./src/herdr/index.ts", "default": "./dist/hostcore/src/herdr/index.js" },
    "./files": { "types": "./src/files/index.ts", "default": "./dist/hostcore/src/files/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json", "test": "vitest run", "typecheck": "tsc -p tsconfig.json --noEmit", "lint": "eslint src test"
  },
  "dependencies": { "yazl": "^3.3.1" },
  "devDependencies": { "fastify": "^5", "typescript": "^5.6", "vitest": "^2", "@types/node": "^22", "@types/yazl": "^3", "eslint": "^9", "typescript-eslint": "^8" }
