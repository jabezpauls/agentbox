#!/usr/bin/env node
// agentbox-status — Claude Code's status line, as agentbox installs it.
//
// Claude Code runs the status line command whenever a session's status
// changes and writes a JSON object to its stdin: the session, the model, the
// context window, and the plan's 5-hour and 7-day rate limits. This passes
// that object on to the bridge, which turns every session's reports into the
// usage meters in the browser, and then prints a status line as before: the
// person's own, when they had one (it is recorded at install and run with the
// same stdin), or a short one of its own.
//
// The status line must never wait on the meters or fail because of them, so
// the report is a single loopback POST with a short timeout, sent while the
// line is being made, and whatever happens this exits 0.
//
//   agentbox-status             the status line (stdin: Claude Code's JSON)
//   agentbox-status install     make ~/.claude/settings.json use it (the entrypoint runs this)
//
// Deliberately dependency-free plain Node, like agentbox-preview. The bridge
// is found at AGENTBOX_STATUS_URL (default http://127.0.0.1:7800).

import { spawn } from "node:child_process";
import fs from "node:fs";
import http from "node:http";
import os from "node:os";
import path from "node:path";

const BASE = (process.env.AGENTBOX_STATUS_URL || "http://127.0.0.1:7800").replace(/\/+$/, "");
const SELF = "agentbox-status";
/** How long the report may take; the bridge answers in a millisecond or two. */
const REPORT_TIMEOUT_MS = 500;
/** How long the person's own status line may take before ours is shown instead. */
const CHAIN_TIMEOUT_MS = 10_000;
/** How long to wait for stdin to close, should Claude Code ever leave it open. */
const STDIN_TIMEOUT_MS = 2_000;

const home = () => process.env.HOME || os.homedir();
const claudeDir = () => process.env.CLAUDE_CONFIG_DIR || path.join(home(), ".claude");
const settingsPath = () => path.join(claudeDir(), "settings.json");
/** Where the person's own status line command is kept once ours takes its place. */
const chainPath = () => path.join(home(), ".agentbox", "statusline-chain.json");

/** True for a command that is this helper, however it is spelled. */
function isSelf(command) {
  if (typeof command !== "string") return false;
  const first = command.trim().split(/\s+/)[0] ?? "";
  return path.basename(first) === SELF;
}

// --- install ---------------------------------------------------------------

/**
 * Make Claude Code's settings use this as the status line, chaining to the
 * one the person had: none → ours; someone else's → theirs is recorded and
 * ours runs it; ours already → nothing. Every other key is kept as it was, and
 * a settings file that does not parse is left alone. Prints one line to stderr
 * saying what it did, and exits 0 whatever happens: the box must start.
 */
function install() {
  const file = settingsPath();
  let settings = {};
  let text = null;
  try {
    text = fs.readFileSync(file, "utf8");
  } catch (err) {
    if (err.code !== "ENOENT") return note(`cannot read ${file} (${err.code}); status line left alone`);
  }
  if (text !== null && text.trim() !== "") {
    try {
      settings = JSON.parse(text);
    } catch {
      return note(`${file} is not valid JSON; status line left alone`);
    }
    if (settings === null || typeof settings !== "object" || Array.isArray(settings)) {
      return note(`${file} is not a JSON object; status line left alone`);
    }
  }

  const current = settings.statusLine;
  if (current && typeof current === "object" && isSelf(current.command)) return;

  let next = { type: "command", command: SELF };
  if (current && typeof current === "object" && typeof current.command === "string" && current.command.trim() !== "") {
    // Theirs, kept to be run by ours; and their other status line settings
    // (refreshInterval, padding) stay as they set them.
    try {
      writeAtomic(chainPath(), `${JSON.stringify({ command: current.command }, null, 2)}\n`);
    } catch (err) {
      return note(`cannot record the existing status line (${err.code ?? err.message}); left alone`);
    }
    next = { ...current, type: "command", command: SELF };
  } else if (current !== undefined && current !== null) {
    // A status line of a kind this cannot run (not a command): leave it.
    return note("the existing status line is not a command; left alone");
  } else {
    // A chain recorded for a status line that has since been removed would
    // otherwise come back to life.
    try {
      fs.rmSync(chainPath(), { force: true });
    } catch {
      // nothing to forget
    }
  }

  settings.statusLine = next;
  try {
    writeAtomic(file, `${JSON.stringify(settings, null, 2)}\n`);
  } catch (err) {
    return note(`cannot write ${file} (${err.code ?? err.message}); status line left alone`);
  }
  note(current ? "status line now reports usage to the Workbench, then runs the previous one" : "status line now reports usage to the Workbench");
}

function note(message) {
  process.stderr.write(`agentbox-status: ${message}\n`);
}

function writeAtomic(file, content) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const tmp = `${file}.agentbox-${process.pid}.tmp`;
  try {
    fs.writeFileSync(tmp, content);
    fs.renameSync(tmp, file);
  } catch (err) {
    fs.rmSync(tmp, { force: true });
    throw err;
  }
}

// --- the status line -------------------------------------------------------

function readStdin() {
  return new Promise((resolve) => {
    const chunks = [];
    const done = () => resolve(Buffer.concat(chunks).toString("utf8"));
    const timer = setTimeout(done, STDIN_TIMEOUT_MS);
    timer.unref();
    process.stdin.on("data", (c) => chunks.push(c));
    process.stdin.on("end", () => {
      clearTimeout(timer);
      done();
    });
    process.stdin.on("error", () => {
      clearTimeout(timer);
      done();
    });
  });
}

/** Deliver the reading to the bridge. Resolves when sent or given up on; never rejects. */
function report(status) {
  return new Promise((resolve) => {
    let body;
    try {
      const payload = { status, at: Date.now() / 1000 };
      const pane = process.env.HERDR_PANE_ID;
      if (pane) payload.paneId = pane;
      body = JSON.stringify(payload);
    } catch {
      resolve();
      return;
    }
    let url;
    try {
      url = new URL(`${BASE}/api/usage/report`);
    } catch {
      resolve();
      return;
    }
    const req = http.request(
      url,
      { method: "POST", headers: { "content-type": "application/json", "content-length": Buffer.byteLength(body) }, timeout: REPORT_TIMEOUT_MS },
      (res) => {
        res.resume();
        res.on("end", resolve);
        res.on("error", resolve);
      },
    );
    req.on("timeout", () => req.destroy());
    req.on("error", () => resolve());
    req.end(body);
  });
}

function chainedCommand() {
  try {
    const { command } = JSON.parse(fs.readFileSync(chainPath(), "utf8"));
    if (typeof command === "string" && command.trim() !== "" && !isSelf(command)) return command;
  } catch {
    // no chain recorded
  }
  return null;
}

/** The person's own status line, with the same stdin; null if it printed nothing or failed to run. */
function runChain(command, input) {
  return new Promise((resolve) => {
    let out = "";
    let child;
    try {
      child = spawn("/bin/sh", ["-c", command], { stdio: ["pipe", "pipe", "inherit"] });
    } catch {
      resolve(null);
      return;
    }
    const timer = setTimeout(() => child.kill("SIGKILL"), CHAIN_TIMEOUT_MS);
    child.stdout.on("data", (c) => (out += c));
    child.stdin.on("error", () => {}); // it may not read its stdin at all
    child.stdin.end(input);
    child.on("error", () => {
      clearTimeout(timer);
      resolve(null);
    });
    child.on("close", () => {
      clearTimeout(timer);
      resolve(out.trim() === "" ? null : out);
    });
  });
}

function pct(x) {
  return typeof x === "number" && Number.isFinite(x) ? `${Math.round(x)}%` : null;
}

/** model · ctx 35% · 5h 31% · 7d 40%, with whatever parts are known. */
function ownLine(status) {
  const parts = [];
  const model = status?.model?.display_name || status?.model?.id;
  if (typeof model === "string") parts.push(model);
  const ctx = pct(status?.context_window?.used_percentage);
  if (ctx) parts.push(`ctx ${ctx}`);
  const five = pct(status?.rate_limits?.five_hour?.used_percentage);
  if (five) parts.push(`5h ${five}`);
  const seven = pct(status?.rate_limits?.seven_day?.used_percentage);
  if (seven) parts.push(`7d ${seven}`);
  return `${parts.length ? parts.join(" · ") : "agentbox"}\n`;
}

async function statusLine() {
  const input = await readStdin();
  let status = null;
  try {
    status = JSON.parse(input);
  } catch {
    status = null;
  }
  const sent = status && typeof status === "object" ? report(status) : Promise.resolve();
  const command = chainedCommand();
  const theirs = command ? await runChain(command, input) : null;
  process.stdout.write(theirs ?? ownLine(status));
  await sent;
}

const main = process.argv[2] === "install" ? async () => install() : statusLine;
main()
  .catch(() => {})
  .finally(() => process.exit(0));
