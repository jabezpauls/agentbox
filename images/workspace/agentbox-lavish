#!/usr/bin/env bash
# Start lavish-axi where the proxy can reach it.
#
# lavish binds loopback by default, and it refuses a wildcard bind address on
# purpose — an unauthenticated file server on 0.0.0.0 would be a bad default.
# It does accept one explicit address, so bind this container's own address on
# the internal Docker network. That network carries nothing but agentbox's own
# containers, and the only way in is through the proxy, which authenticates
# first; see docs/security.md.
set -euo pipefail

if [ -z "${LAVISH_AXI_HOST:-}" ]; then
    LAVISH_AXI_HOST="$(hostname -i | awk '{print $1}')"
    export LAVISH_AXI_HOST
fi

exec lavish-axi server "$@"
