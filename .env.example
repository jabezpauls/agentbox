# Copy to .env (install.sh writes this for you) and keep it out of version
# control — it holds your password hash and any agent API keys.

# Hostname you will browse to. Used for the TLS certificate in standalone mode.
AGENTBOX_DOMAIN=code.example.com

# standalone  = this stack owns ports 80/443 and manages its own certificate
# behind-proxy = bind loopback only; your existing proxy fronts it
# traefik      = no published port; a container Traefik on the edge network routes to it
AGENTBOX_MODE=standalone

# behind-proxy only: the address the stack listens on for your proxy to reach.
AGENTBOX_BIND=127.0.0.1:8443
# on only when AGENTBOX_BIND is deliberately not loopback (install.sh --bind-public).
AGENTBOX_BIND_PUBLIC=off

# traefik only: the external network your Traefik already watches, and the cert
# resolver it should use for this host.
AGENTBOX_EDGE_NETWORK=edge-prod
AGENTBOX_CERT_RESOLVER=letsencrypt

# The sign-in. The gate (a container outside the sandbox) keeps the password in
# its own store as a bcrypt hash; the plaintext is never stored. This hash only
# seeds a fresh store — change the password with ./scripts/agentbox passwd,
# which writes the store and leaves this line alone.
AGENTBOX_USER=admin
AGENTBOX_PASSWORD_HASH=

# on: you may make an app public from the Preview panel (anyone with the link,
# or a passcode, for as long as you choose). off: every app stays private, and
# anything shared becomes private at the next start. The gate enforces it.
# (install.sh --sharing on|off writes it; --preview path|off is its old name.)
AGENTBOX_SHARING=on

# Optional: more ports that must never be served as apps, comma-separated
# (agentbox's own — 8080, 7681-7683, 2222, 7800, 7801, 7900, 7901 — always are).
# AGENTBOX_INFRA_PORTS=

# Is the hostname proxied through Cloudflare (an orange-cloud DNS record, or a
# Cloudflare Tunnel)? on/off. Decides whose address the gate's sign-in limits
# count: with it on, Caddy trusts Cloudflare's published ranges and reads the
# visitor's address past them. Default on in traefik mode, off otherwise
# (install.sh --cloudflare on|off writes it).
# AGENTBOX_CLOUDFLARE=

# Optional, rarely needed (behind-proxy and traefik modes). Caddy reads the
# visitor's address from X-Forwarded-For past the proxies it trusts (and
# CF-Connecting-IP behind Cloudflare: that is --cloudflare on, not this). Name
# a header here, e.g. X-Real-IP, to read it first instead: your proxy in front
# of agentbox must then overwrite it on every request, or a client can forge
# it. Not CF-Connecting-IP or X-Forwarded-For (install.sh --real-ip-header
# refuses both). It replaces AGENTBOX_CLIENT_IP_HEADER, an older key that
# install.sh and ./scripts/agentbox update remove.
# AGENTBOX_REAL_IP_HEADER=

# Which coding agents to build into the image, comma-separated. Known names:
# claude (@anthropic-ai/claude-code), codex (@openai/codex). herdr is always
# installed regardless. Set it empty for no agents; remove the line for the
# default pair. Changing this takes effect on the next build/update.
AGENTBOX_AGENTS=claude,codex

# Optional. The origin you browse to, used only so `agentbox-review open` and
# `agentbox-preview` print a link an agent can hand you. Left blank, the link is built from
# whichever Host the request arrived with, which is right for a local install
# and wrong behind a proxy that rewrites it.
AGENTBOX_PUBLIC_URL=https://code.example.com

# Ceilings for the sandbox as a whole, per service.
AGENTBOX_CPUS=2
AGENTBOX_MEMORY=4g

# Ceilings for the proxy container.
AGENTBOX_PROXY_CPUS=1
AGENTBOX_PROXY_MEMORY=256m

# Ceilings for the gate. Its bcrypt check is deliberately slow; its rate limits
# refuse a flood before any bcrypt work, and this cap bounds what is left.
# AGENTBOX_GATE_CPUS=1
# AGENTBOX_GATE_MEMORY=256m

TZ=UTC

# Which agentbox this is: built into the images, and shown on the System
# surface and by the gate at /_gate/version. install.sh and
# ./scripts/agentbox update write it from the checkout (`git describe --tags
# --always --dirty`); left out, the images say dev.
# AGENTBOX_VERSION=

# Optional. Set these to have agents authenticate without an interactive login.
# Leave blank to sign in from inside the sandbox instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
