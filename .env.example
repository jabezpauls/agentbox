# Copy to .env (install.sh writes this for you) and keep it out of version
# control — it holds your password hash and any agent API keys.

# Hostname you will browse to. Used for the TLS certificate in standalone mode.
AGENTBOX_DOMAIN=code.example.com

# standalone  = this stack owns ports 80/443 and manages its own certificate
# behind-proxy = bind loopback only; your existing proxy fronts it
AGENTBOX_MODE=standalone

# behind-proxy only: the address the stack listens on for your proxy to reach.
AGENTBOX_BIND=127.0.0.1:8443

# Login for the browser. The hash is bcrypt, produced by `caddy hash-password`;
# the plaintext password is never stored.
AGENTBOX_USER=admin
AGENTBOX_PASSWORD_HASH=

# Ceilings for the sandbox as a whole, per service.
AGENTBOX_CPUS=2
AGENTBOX_MEMORY=4g

TZ=UTC

# Optional. Set these to have agents authenticate without an interactive login.
# Leave blank to sign in from inside the sandbox instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
